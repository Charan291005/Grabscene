# GrabScene Environment Variables
# Copy this file to .env.local and fill in the values from your Supabase project

# Supabase Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Settings -> API) - Used for public client access
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Settings -> API) - Secret, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL for the application (used in emails and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
